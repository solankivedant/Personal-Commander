{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Munshiji Preview",
  "version": "0.1.0",
  "identifier": "com.munshiji.preview",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Munshiji — Control Center (Preview Build)",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Munshiji",
    "copyright": "Munshiji preview build — not the shipping product.",
    "shortDescription": "Munshiji Control Center — UI preview build",
    "longDescription": "A visual preview of Munshiji's planned Control Center dashboard. No voice, file, or system control is wired up yet — see the Roadmap tab inside the app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
