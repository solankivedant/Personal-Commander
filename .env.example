# Copy to .env and fill in real values. Never commit the real .env file
# (see .gitignore) — see .claude/rules/security-and-privacy.md for credential
# handling rules. Secrets belong in the Windows Credential Manager (`keyring`)
# at runtime; this file is only for local development convenience.

# --- Google (app-password path, §7.6) ---
GOOGLE_APP_EMAIL=your-account@gmail.com
GOOGLE_APP_PASSWORD=changeme-16-char-app-password

# --- Google (OAuth2 path, §7.6) ---
# GOOGLE_OAUTH_CLIENT_SECRETS_PATH=./credentials.json

# --- Cloud LLM escalation (optional, off by default — see config/default.yaml cloud.enabled) ---
ANTHROPIC_API_KEY=sk-ant-changeme

# --- Local API bearer token (net/api.py — never bind 0.0.0.0) ---
MUNSHIJI_API_TOKEN=changeme

# --- Licence server (Phase 9) ---
LICENCE_SERVER_URL=https://licence.example.com
LICENCE_SIGNING_PUBLIC_KEY=changeme-ed25519-public-key
